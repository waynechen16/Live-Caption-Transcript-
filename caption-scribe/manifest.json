{
  "manifest_version": 3,
  "name": "Caption Scribe 字幕同步翻譯（DOM 版）",
  "description": "擷取 Teams / Webex / Google Meet 等網頁即時字幕（DOM capture），每句同步翻譯出繁中＋英文，面板即時顯示並可匯出逐字稿；可選錄音（分頁聲音＋麥克風）下載 MP3。",
  "version": "1.3.2",
  "permissions": ["storage", "scripting", "activeTab", "tabCapture", "offscreen", "downloads"],
  "host_permissions": [
    "https://teams.microsoft.com/*",
    "https://teams.live.com/*",
    "https://*.webex.com/*",
    "https://meet.google.com/*",
    "https://api-free.deepl.com/*",
    "https://api.deepl.com/*",
    "https://generativelanguage.googleapis.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://teams.microsoft.com/*",
        "https://teams.live.com/*",
        "https://*.webex.com/*",
        "https://meet.google.com/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Caption Scribe",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
